<?xml version="1.0" encoding="utf-8"?>
<!--
  `dotnet publish` transforms this file (rather than generating one from scratch) to add the
  aspNetCore handler/module registration — see the ASP.NET Core SDK's web.config transform docs.
  Checking this in keeps our own additions (Windows Auth) stable across every publish, instead of
  needing to be re-applied by hand via IIS Manager/PowerShell after each redeploy, which is what
  silently broke auth the first time this app was deployed (see git history).
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <windowsAuthentication enabled="true">
          <providers>
            <clear />
            <add value="NTLM" />
          </providers>
        </windowsAuthentication>
        <!-- Anonymous must stay enabled alongside Windows Auth here, specifically so CORS preflight
             (OPTIONS) requests succeed — browsers send preflight without credentials, and with
             Anonymous disabled IIS's Windows Auth module rejects it with 401 before ASP.NET Core's
             CORS middleware ever runs, which silently breaks every cross-origin POST/PUT (the
             frontend is a separate origin now — see Program.cs's CORS comment). This is safe with
             IISDefaults.AuthenticationScheme (unlike the earlier AddNegotiate() setup): the app's
             own FallbackPolicy (RequireAuthenticatedUser) still rejects any real, non-preflight
             request that comes through anonymous. -->
        <anonymousAuthentication enabled="true" />
      </authentication>
    </security>
  </system.webServer>
</configuration>

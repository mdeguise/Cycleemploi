# Copy to .env and fill in real values. Never commit .env itself (see .gitignore).
# Every value here corresponds to a Phase 0 item in the plan (C:\Users\mdeguise\.claude\plans\
# spicy-nibbling-pudding.md) — none of these can be filled in without tenant admin / DBA action.

# --- SQL Server (vm-trm-sql1) ---
# Windows Integrated Auth (used for local dev, see backend/Api/appsettings.json) isn't available to
# the Linux container the same way — needs a real SQL Server auth login provisioned for the app,
# with SELECT on Redingote.dbo.WorkdayDemographic and full DML on EmployeeLifecycle.
SQL_SERVER=vm-trm-sql1
SQL_APP_USER=TODO-sql-login
SQL_APP_PASSWORD=TODO-sql-password

# --- Entra ID ---
# Two app registrations needed: one SPA (frontend), one API (backend). See plan Phase 0, item 3.
AAD_TENANT_ID=TODO-tenant-id
AAD_SPA_CLIENT_ID=TODO-spa-app-registration-client-id
AAD_API_CLIENT_ID=TODO-api-app-registration-client-id
AAD_API_CLIENT_SECRET=TODO-api-app-registration-client-secret

# --- HR access control ---
# TRM-RH-ADM's Entra object id — gates read access to the confidential RH comment field.
TRM_RH_ADM_GROUP_ID=TODO-trm-rh-adm-group-object-id

# --- Misc ---
WEB_PORT=8443

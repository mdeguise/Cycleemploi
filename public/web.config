<?xml version="1.0" encoding="utf-8"?>
<!--
  Ships into dist/ automatically (Vite copies everything under public/ to the build output root).
  Deploy dist/ as its own IIS site's content root. The backend is a SEPARATE top-level IIS site on
  its own port (not a nested Application under this site) — that nested-Application topology was
  tried first and abandoned after Windows Authentication on the nested app produced an empty,
  unresolved 404 that never reached the ASP.NET Core process; see git history / Program.cs's CORS
  comment. The frontend calls the API cross-origin now, via CORS + credentials: 'include'
  (src/api/client.ts), using VITE_API_BASE_URL (.env.production) for the API's real origin.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- SPA fallback: any request that isn't a real file/directory goes to index.html so
             client-side routing can handle it. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <!-- IIS persists Windows Authentication config into this physical web.config file rather than
         applicationHost.config, regardless of which PSPath format is used to set it — so setting it
         by hand via IIS Manager/PowerShell only lasts until the next deploy overwrites this file.
         Baking it in here keeps it stable across redeploys. Static content only (no sensitive data
         server-side) — the real access control is the API requiring authenticated requests for all
         data — but this keeps the app shell itself off-limits to anonymous/unauthenticated users too,
         consistent with the "internal only" positioning. -->
    <security>
      <authentication>
        <windowsAuthentication enabled="true" />
        <anonymousAuthentication enabled="false" />
      </authentication>
    </security>
  </system.webServer>
  <!-- Vite content-hashes every JS/CSS filename, so THOSE can cache forever — but index.html
       references those hashed names and has no versioned name of its own. Without this, a
       browser that cached index.html before a redeploy keeps citing the OLD bundle after one,
       which reads as "the new feature isn't there" until a hard refresh. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>

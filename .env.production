# Production builds (`npm run build`) must point at the API's own origin — the frontend and API
# are hosted as separate top-level IIS sites/ports (not a nested Application; see Program.cs's CORS
# comment for why), so this can no longer be empty/relative like a same-origin deployment would use.
#
# This file exists because Vite loads .env.local for EVERY mode, including production builds — not
# just `npm run dev`. Without this override, a dev machine's .env.local (which points at
# http://localhost:5211 for local Kestrel testing) leaks into the production bundle. See
# src/api/client.ts.
VITE_API_BASE_URL=http://vm-trm-live:8091
